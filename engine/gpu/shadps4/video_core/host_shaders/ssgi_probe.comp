// Screen-space radiance probes: one probe per 16x16 tile stores 8x8 octahedral radiance (view
// space), accumulated over frames. Diffuse and rough specular both read its L1 SH; the resolved
// per-pixel lighting is then accumulated over frames as well. Optionally, glossy surfaces trace
// one GGX-sampled reflection ray per 2x2 pixels, or per pixel at full resolution (REFLECT),
// filtered spatially and over frames (RESOLVE), which replaces the probe specular where it hits.
//
// history bits: 1 = probe history valid, 2 = glossy reflection rays on, 4 = ray history valid,
// 8..15 = glossy reflection strength * 255, 16 = full-resolution reflection rays, 18..25 = wet
// ground * 255, 26 = view-space world up has negative z. After the probe trace, `feedback` holds
// the view-space world up (x, y) as two unorm16.

#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Constants {
    vec4 proj;
    vec4 reproject[3];
    vec2 size;
    vec2 jitter;
    vec2 prev_jitter;
    vec2 prev_proj;
    uint frame;
    uint history;
    float diffuse_scale;
    float specular_scale;
    float feedback;
    float ao_amount;
    float albedo_on;
    float material_on;
};

const int TILE = 16;
const int OCT = 8;
const float PI = 3.14159265358979;
const float ALBEDO = 0.5;

ivec2 tileCount() {
    return (ivec2(size) + TILE - 1) / TILE;
}

float viewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}

vec3 viewPos(vec2 pixel, float z) {
    const vec2 ndc = (pixel - jitter) / size * 2.0 - 1.0;
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}

vec3 prevViewPos(vec2 pixel, float z) {
    const vec2 ndc = (pixel - prev_jitter) / size * 2.0 - 1.0;
    return vec3(ndc.x * z / prev_proj.x, ndc.y * z / prev_proj.y, z);
}

vec2 projectPixel(vec3 p) {
    return (p.xy * proj.xy / p.z * 0.5 + 0.5) * size + jitter;
}

vec3 toPrevious(vec3 p) {
    const vec4 v = vec4(p, 1.0);
    return vec3(dot(reproject[0], v), dot(reproject[1], v), dot(reproject[2], v));
}

vec3 rotateToPrevious(vec3 d) {
    return vec3(dot(reproject[0].xyz, d), dot(reproject[1].xyz, d), dot(reproject[2].xyz, d));
}

vec2 prevPixel(vec3 p) {
    return (p.xy * prev_proj / p.z * 0.5 + 0.5) * size + prev_jitter;
}

vec2 signNotZero(vec2 v) {
    return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

// The camera-facing hemisphere (-z) maps to the centre of the octahedron.
vec2 octEncode(vec3 d) {
    d = vec3(d.x, d.y, -d.z) / (abs(d.x) + abs(d.y) + abs(d.z));
    const vec2 p = d.z >= 0.0 ? d.xy : (1.0 - abs(d.yx)) * signNotZero(d.xy);
    return p * 0.5 + 0.5;
}

vec3 octDecode(vec2 uv) {
    const vec2 p = uv * 2.0 - 1.0;
    vec3 d = vec3(p, 1.0 - abs(p.x) - abs(p.y));
    d.xy -= max(-d.z, 0.0) * signNotZero(d.xy);
    d = normalize(d);
    return vec3(d.x, d.y, -d.z);
}

vec4 shBasis(vec3 d) {
    return vec4(0.282095, 0.488603 * d.y, 0.488603 * d.z, 0.488603 * d.x);
}

vec3 shIrradiance(vec4 r, vec4 g, vec4 b, vec3 n) {
    const vec4 k = vec4(PI, 2.0 * PI / 3.0, 2.0 * PI / 3.0, 2.0 * PI / 3.0) * shBasis(n);
    return max(vec3(dot(r, k), dot(g, k), dot(b, k)), vec3(0.0));
}

// Radiance around `d` convolved with a lobe whose band-1 zonal factor is `band1` (1 = unfiltered).
vec3 shRadiance(vec4 r, vec4 g, vec4 b, vec3 d, float band1) {
    const vec4 k = shBasis(d) * vec4(1.0, band1, band1, band1);
    return max(vec3(dot(r, k), dot(g, k), dot(b, k)), vec3(0.0));
}

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rand(uint seed) {
    return float(hash(seed) >> 8) * (1.0 / 16777216.0);
}

// probe texel: x = pixel offset in the tile (x + 16y), y = view z (0 = no probe), zw = normal.
vec3 probePixel(ivec2 tile, vec4 probe) {
    const float o = probe.x;
    return vec3(vec2(tile * TILE) + vec2(mod(o, 16.0), floor(o / 16.0)) + 0.5, probe.y);
}

const float RAY_MAX_ROUGHNESS = 0.7;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Glossy reflection strength 1 = 3x the physically weighted reflection.
const float REFLECTION_STRENGTH_SCALE = 3.0;

bool fullResRays() {
    return (history & 0x10000u) != 0u;
}

ivec2 raySize() {
    return fullResRays() ? ivec2(size) : (ivec2(size) + 1) / 2;
}

// Each half-resolution reflection pixel traces from one pixel of its 2x2 block, cycling through
// the block over four frames.
ivec2 rayPixelAt(ivec2 ray_pixel, uint at_frame) {
    if (fullResRays()) {
        return ray_pixel;
    }
    const ivec2 offsets[4] = ivec2[4](ivec2(0, 0), ivec2(1, 1), ivec2(1, 0), ivec2(0, 1));
    return min(ray_pixel * 2 + offsets[at_frame & 3u], ivec2(size) - 1);
}

ivec2 rayPixel(ivec2 ray_pixel) {
    return rayPixelAt(ray_pixel, frame);
}

// Luminance-compressed colour: averaging in this space keeps a single very bright sample (a ray
// that hit a fire) from dominating, which would otherwise sparkle.
vec3 compressColor(vec3 c) {
    return c / (1.0 + luminance(c));
}

vec3 expandColor(vec3 c) {
    return c / max(1.0 - luminance(c), 1e-3);
}

// G-buffer specular exponent (material.r) to perceptual GGX roughness.
float materialRoughness(float m) {
    const float exponent = exp2(13.0 * m);
    const float c2 = exp2(-2.0 / exponent);
    const float a2 = clamp((1.0 - c2) / (1.41421356 * c2), 1e-6, 1.0);
    return sqrt(sqrt(a2));
}

const float WET_ROUGHNESS = 0.08;

// Wet ground: surfaces facing up (world +y) get smoother, like rain-wet stone, for the glossy
// reflection rays.
float wetRoughness(float roughness, vec3 n) {
    const float wet = float((history >> 18u) & 255u) * (1.0 / 255.0);
    if (wet <= 0.0) {
        return roughness;
    }
    const vec2 xy = unpackUnorm2x16(floatBitsToUint(feedback)) * 2.0 - 1.0;
    const vec3 up = vec3(xy, ((history & 0x4000000u) != 0u ? -1.0 : 1.0) *
                                 sqrt(max(1.0 - dot(xy, xy), 0.0)));
    const float facing = smoothstep(0.6, 0.9, dot(n, up));
    return mix(roughness, min(roughness, WET_ROUGHNESS), wet * facing);
}

#if defined(TRACE)

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1) uniform texture2D geo_tex;
layout(binding = 2) uniform texture2D color_tex;
layout(binding = 3) uniform texture2D albedo_tex;
layout(binding = 4) uniform texture2D prev_probe_tex;
layout(binding = 5) uniform texture2D prev_light_tex;
layout(binding = 6) uniform texture2D prev_sh_r;
layout(binding = 7) uniform texture2D prev_sh_g;
layout(binding = 8) uniform texture2D prev_sh_b;
layout(binding = 9, rgba32f) uniform writeonly image2D probe_img;
layout(binding = 10, rgba16f) uniform writeonly image2D light_img;
layout(binding = 11, rgba16f) uniform writeonly image2D sh_r_img;
layout(binding = 12, rgba16f) uniform writeonly image2D sh_g_img;
layout(binding = 13, rgba16f) uniform writeonly image2D sh_b_img;

const int STEPS = 16;
const float MAX_DISTANCE = 12.0;
const float RADIANCE_CLAMP = 10.0;
const float MAX_HISTORY = 24.0;

shared uint chosen;
shared ivec2 history_tile;
shared vec3 sh_acc[4][64];

// Probes sit on the valid candidate nearest the tile centre, so they stay on the same surface
// from frame to frame instead of jumping around (which breaks history and flickers).
ivec2 cellOf(uint index) {
    return ivec2(index & 7u, index >> 3) * 2 + 1;
}

uint cellPriority(uint index) {
    const ivec2 d = ivec2(index & 7u, index >> 3) * 2 - 7;
    return (uint(d.x * d.x + d.y * d.y) << 6) | index;
}

bool previousProbe(ivec2 pt, out vec3 pos, out vec3 normal) {
    const ivec2 tiles = tileCount();
    if (any(lessThan(pt, ivec2(0))) || any(greaterThanEqual(pt, tiles))) {
        return false;
    }
    const vec4 probe = texelFetch(prev_probe_tex, pt, 0);
    if (probe.y <= 0.0) {
        return false;
    }
    const vec3 pixel = probePixel(pt, probe);
    pos = prevViewPos(pixel.xy, pixel.z);
    normal = octDecode(probe.zw);
    return true;
}

vec3 feedbackLight(vec3 hit, vec3 hit_normal, ivec2 q) {
    const vec3 p = toPrevious(hit);
    if (p.z < 1e-3) {
        return vec3(0.0);
    }
    const ivec2 pt = ivec2(floor(prevPixel(p) / float(TILE)));
    vec3 pos, normal;
    if (!previousProbe(pt, pos, normal) || abs(dot(normal, p - pos)) > 0.1 + 0.02 * p.z) {
        return vec3(0.0);
    }
    const vec3 e = shIrradiance(texelFetch(prev_sh_r, pt, 0), texelFetch(prev_sh_g, pt, 0),
                                texelFetch(prev_sh_b, pt, 0), rotateToPrevious(hit_normal));
    const vec3 albedo = albedo_on > 0.5 ? texelFetch(albedo_tex, q, 0).rgb : vec3(ALBEDO);
    // Capped below 1 so light bouncing between walls cannot grow without bound.
    return e * (1.0 / PI) * albedo * (feedback * min(diffuse_scale, 1.0));
}

vec3 trace(vec3 pos, vec3 normal, vec3 dir, float noise) {
    const vec3 origin = pos + normal * (0.03 + 0.003 * pos.z);
    float reach = MAX_DISTANCE;
    if (dir.z < 0.0) {
        reach = min(reach, (origin.z - 0.05) / -dir.z);
    }
    if (reach <= 0.02) {
        return vec3(0.0);
    }
    const vec3 end = origin + dir * reach;
    const vec2 s0 = projectPixel(origin);
    const vec2 delta = projectPixel(end) - s0;
    float u_max = 1.0;
    for (int a = 0; a < 2; ++a) {
        const float e = s0[a] + delta[a];
        if (e < 0.0) {
            u_max = min(u_max, -s0[a] / delta[a]);
        } else if (e > size[a]) {
            u_max = min(u_max, (size[a] - s0[a]) / delta[a]);
        }
    }
    const float full = length(delta);
    if (full * u_max < 2.0) {
        return vec3(0.0);
    }
    const float u_min = 1.5 / full;
    const float inv0 = 1.0 / origin.z, inv1 = 1.0 / end.z;
    float last_z = origin.z;
    const ivec2 isize = ivec2(size);
    for (int i = 0; i < STEPS; ++i) {
        const float f = (float(i) + noise) / float(STEPS);
        const float u = mix(u_min, u_max, f * f);
        const ivec2 q = clamp(ivec2(s0 + delta * u), ivec2(0), isize - 1);
        const float ray_z = 1.0 / mix(inv0, inv1, u);
        const float thickness = max(0.3 + 0.03 * ray_z, abs(ray_z - last_z));
        last_z = ray_z;
        const float depth = texelFetch(depth_tex, q, 0).r;
        if (depth >= 1.0) {
            continue;
        }
        const float diff = ray_z - viewZ(depth);
        if (diff > 0.0 && diff < thickness) {
            const vec4 g = texelFetch(geo_tex, q, 0);
            if (g.w <= 0.0 || dot(g.xyz, dir) > 0.1) {
                return vec3(0.0);
            }
            vec3 c = texelFetch(color_tex, q, 0).rgb;
            if ((history & 1u) != 0u && feedback > 0.0) {
                c += feedbackLight(viewPos(vec2(q) + 0.5, g.w), g.xyz, q);
            }
            return min(c, vec3(RADIANCE_CLAMP));
        }
    }
    return vec3(0.0);
}

void main() {
    const ivec2 tile = ivec2(gl_WorkGroupID.xy);
    const uint lid = gl_LocalInvocationIndex;
    const ivec2 texel = ivec2(lid & 7u, lid >> 3);
    const ivec2 isize = ivec2(size);
    const uint seed = hash(uint(tile.x) * 73856093u ^ uint(tile.y) * 19349663u ^
                           (frame & 1023u) * 83492791u);
    if (lid == 0u) {
        chosen = 0xFFFFFFFFu;
        history_tile = ivec2(-1);
    }
    barrier();

    {
        const ivec2 cand = tile * TILE + cellOf(lid);
        if (all(lessThan(cand, isize)) && texelFetch(geo_tex, cand, 0).w > 0.0) {
            atomicMin(chosen, cellPriority(lid));
        }
    }
    barrier();

    const ivec2 out_texel = tile * OCT + texel;
    if (chosen == 0xFFFFFFFFu) {
        imageStore(light_img, out_texel, vec4(0.0));
        if (lid == 0u) {
            imageStore(probe_img, tile, vec4(0.0));
            imageStore(sh_r_img, tile, vec4(0.0));
            imageStore(sh_g_img, tile, vec4(0.0));
            imageStore(sh_b_img, tile, vec4(0.0));
        }
        return;
    }
    const ivec2 offset = cellOf(chosen & 63u);
    const ivec2 pixel = tile * TILE + offset;
    const vec4 geo = texelFetch(geo_tex, pixel, 0);
    const vec3 normal = geo.xyz;
    const vec3 pos = viewPos(vec2(pixel) + 0.5, geo.w);

    if (lid == 0u && (history & 1u) != 0u) {
        const vec3 p = toPrevious(pos);
        if (p.z > 1e-3) {
            const vec2 tf = prevPixel(p) / float(TILE) - 0.5;
            const ivec2 base = ivec2(floor(tf));
            const vec3 prev_normal = rotateToPrevious(normal);
            float best = 1e30;
            for (int i = 0; i < 4; ++i) {
                const ivec2 pt = base + ivec2(i & 1, i >> 1);
                vec3 ppos, pnormal;
                if (!previousProbe(pt, ppos, pnormal) || dot(pnormal, prev_normal) < 0.5) {
                    continue;
                }
                const float plane = abs(dot(pnormal, p - ppos));
                if (plane > 0.1 + 0.03 * p.z) {
                    continue;
                }
                const float score = plane + 0.05 * length(p - ppos);
                if (score < best) {
                    best = score;
                    history_tile = pt;
                }
            }
        }
    }
    barrier();

    const vec3 centre_dir = octDecode((vec2(texel) + 0.5) / float(OCT));
    const uint ray_seed = seed ^ (lid * 2654435761u);
    const vec2 sub = vec2(rand(ray_seed), rand(ray_seed ^ 0x9e3779b9u));
    const vec3 dir = octDecode((vec2(texel) + sub) / float(OCT));
    vec3 radiance = vec3(0.0);
    if (dot(dir, normal) > 0.0) {
        radiance = trace(pos, normal, dir, rand(ray_seed ^ 0x85ebca6bu));
    }

    float count = 1.0;
    if (history_tile.x >= 0) {
        const vec2 uv = clamp(octEncode(rotateToPrevious(centre_dir)) * float(OCT) - 0.5, vec2(0.0),
                              vec2(OCT - 1));
        const ivec2 b = min(ivec2(floor(uv)), ivec2(OCT - 2));
        const vec2 f = uv - vec2(b);
        const ivec2 base = history_tile * OCT + b;
        const vec4 h00 = texelFetch(prev_light_tex, base, 0);
        const vec4 h10 = texelFetch(prev_light_tex, base + ivec2(1, 0), 0);
        const vec4 h01 = texelFetch(prev_light_tex, base + ivec2(0, 1), 0);
        const vec4 h11 = texelFetch(prev_light_tex, base + ivec2(1, 1), 0);
        const vec4 hist = mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
        count = min(hist.a + 1.0, MAX_HISTORY);
        // Once history has settled, clamp one-ray outliers so a lucky hit on a lamp does not
        // flash the whole probe.
        if (hist.a >= 4.0) {
            const float luma = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
            const float limit = 4.0 * dot(hist.rgb, vec3(0.2126, 0.7152, 0.0722)) + 0.05;
            radiance *= luma > limit ? limit / luma : 1.0;
        }
        radiance = mix(hist.rgb, radiance, 1.0 / count);
    }
    imageStore(light_img, out_texel, vec4(radiance, count));

    const vec4 basis = shBasis(centre_dir) * (4.0 * PI / float(OCT * OCT));
    sh_acc[0][lid] = radiance * basis.x;
    sh_acc[1][lid] = radiance * basis.y;
    sh_acc[2][lid] = radiance * basis.z;
    sh_acc[3][lid] = radiance * basis.w;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            for (int k = 0; k < 4; ++k) {
                sh_acc[k][lid] += sh_acc[k][lid + stride];
            }
        }
        barrier();
    }
    if (lid == 0u) {
        imageStore(probe_img, tile, vec4(float(offset.x + offset.y * TILE), geo.w,
                                         octEncode(normal)));
        imageStore(sh_r_img, tile, vec4(sh_acc[0][0].r, sh_acc[1][0].r, sh_acc[2][0].r,
                                        sh_acc[3][0].r));
        imageStore(sh_g_img, tile, vec4(sh_acc[0][0].g, sh_acc[1][0].g, sh_acc[2][0].g,
                                        sh_acc[3][0].g));
        imageStore(sh_b_img, tile, vec4(sh_acc[0][0].b, sh_acc[1][0].b, sh_acc[2][0].b,
                                        sh_acc[3][0].b));
    }
}

#elif defined(REFLECT)

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1) uniform texture2D geo_tex;
layout(binding = 2) uniform texture2D color_tex;
layout(binding = 3) uniform texture2D material_tex;
layout(binding = 4, rgba16f) uniform writeonly image2D ray_img;
layout(binding = 5, r16f) uniform writeonly image2D dist_img;

const int RAY_STEPS = 32;
const int RAY_STEPS_SMOOTH = 56;
const int RAY_REFINE = 6;
const float RAY_DISTANCE = 40.0;
const float RAY_CLAMP = 10.0;
// Drops the far tail of the GGX lobe: slightly narrower highlights for much less noise.
const float GGX_TAIL_TRIM = 0.75;
const float MIRROR_ROUGHNESS = 0.12;

// Heitz 2018, sampling the GGX distribution of visible normals.
vec3 sampleGgxReflection(vec3 v, vec3 n, float alpha, vec2 u) {
    const vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    const vec3 tx = normalize(cross(up, n));
    const vec3 ty = cross(n, tx);
    const vec3 ve = vec3(dot(v, tx), dot(v, ty), dot(v, n));
    const vec3 vh = normalize(vec3(alpha * ve.x, alpha * ve.y, ve.z));
    const float lensq = vh.x * vh.x + vh.y * vh.y;
    const vec3 t1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
    const vec3 t2 = cross(vh, t1);
    const float r = sqrt(u.x);
    const float phi = 2.0 * PI * u.y;
    const float p1 = r * cos(phi);
    const float s = 0.5 * (1.0 + vh.z);
    const float p2 = (1.0 - s) * sqrt(max(1.0 - p1 * p1, 0.0)) + s * r * sin(phi);
    const vec3 nh = p1 * t1 + p2 * t2 + sqrt(max(1.0 - p1 * p1 - p2 * p2, 0.0)) * vh;
    const vec3 h = normalize(vec3(alpha * nh.x, alpha * nh.y, max(nh.z, 0.0)));
    const vec3 l = reflect(-v, tx * h.x + ty * h.y + n * h.z);
    return dot(l, n) > 0.0 ? l : reflect(-v, n);
}

// Surface normal from the depth buffer, choosing the closer neighbour on each axis so edges do
// not bend it.
vec3 geometricNormal(ivec2 pixel, vec3 pos, vec3 fallback) {
    const ivec2 lim = ivec2(size) - 1;
    vec3 axes[2];
    for (int a = 0; a < 2; ++a) {
        const ivec2 o = a == 0 ? ivec2(1, 0) : ivec2(0, 1);
        const ivec2 pp = clamp(pixel + o, ivec2(0), lim), pm = clamp(pixel - o, ivec2(0), lim);
        const float dp = texelFetch(depth_tex, pp, 0).r, dm = texelFetch(depth_tex, pm, 0).r;
        const vec3 qp = viewPos(vec2(pp) + 0.5, viewZ(dp));
        const vec3 qm = viewPos(vec2(pm) + 0.5, viewZ(dm));
        const bool use_p = dm >= 1.0 || (dp < 1.0 && abs(qp.z - pos.z) < abs(qm.z - pos.z));
        axes[a] = use_p ? qp - pos : pos - qm;
    }
    vec3 g = cross(axes[0], axes[1]);
    if (dot(g, g) < 1e-12) {
        return fallback;
    }
    g = normalize(g);
    return dot(g, fallback) < 0.0 ? -g : g;
}

float rayDepthDiff(vec2 s0, vec2 delta, float inv0, float inv1, float u, out ivec2 q) {
    q = clamp(ivec2(s0 + delta * u), ivec2(0), ivec2(size) - 1);
    const float depth = texelFetch(depth_tex, q, 0).r;
    if (depth >= 1.0) {
        return -1e30;
    }
    return 1.0 / mix(inv0, inv1, u) - viewZ(depth);
}

// rgb = radiance, a = hit weight (0 on a miss, faded towards the screen edges); hit_dist = view
// distance to the hit. `plane` is the geometric (depth-derived) surface normal: normal-mapped
// normals tilt rays into the surface they start from, so hits lying on that surface are rejected
// rather than reflecting itself.
vec4 traceReflection(vec3 pos, vec3 plane, vec3 dir, float noise, int steps, out float hit_dist) {
    hit_dist = 0.0;
    const vec3 origin = pos + plane * (0.02 + 0.004 * pos.z);
    float reach = RAY_DISTANCE;
    if (dir.z < 0.0) {
        reach = min(reach, (origin.z - 0.05) / -dir.z);
    }
    if (reach <= 0.02) {
        return vec4(0.0);
    }
    const vec3 end = origin + dir * reach;
    const vec2 s0 = projectPixel(origin);
    const vec2 delta = projectPixel(end) - s0;
    float u_max = 1.0;
    for (int a = 0; a < 2; ++a) {
        const float e = s0[a] + delta[a];
        if (e < 0.0) {
            u_max = min(u_max, -s0[a] / delta[a]);
        } else if (e > size[a]) {
            u_max = min(u_max, (size[a] - s0[a]) / delta[a]);
        }
    }
    const float full = length(delta);
    if (full * u_max < 1.5) {
        return vec4(0.0);
    }
    const float u_min = 1.0 / full;
    const float inv0 = 1.0 / origin.z, inv1 = 1.0 / end.z;
    float last_u = u_min, last_z = origin.z;
    for (int i = 0; i < steps; ++i) {
        const float f = (float(i) + noise) / float(steps);
        const float u = mix(u_min, u_max, f * f);
        const float ray_z = 1.0 / mix(inv0, inv1, u);
        const float thickness = max(0.15 + 0.02 * ray_z, abs(ray_z - last_z) * 1.5);
        ivec2 q;
        const float diff = rayDepthDiff(s0, delta, inv0, inv1, u, q);
        if (diff > 0.0 && diff < thickness) {
            float lo = last_u, hi = u;
            for (int k = 0; k < RAY_REFINE; ++k) {
                const float mid = 0.5 * (lo + hi);
                ivec2 qm;
                if (rayDepthDiff(s0, delta, inv0, inv1, mid, qm) > 0.0) {
                    hi = mid;
                } else {
                    lo = mid;
                }
            }
            rayDepthDiff(s0, delta, inv0, inv1, hi, q);
            const vec4 g = texelFetch(geo_tex, q, 0);
            if (g.w <= 0.0 || dot(g.xyz, dir) > 0.1) {
                return vec4(0.0);
            }
            const vec3 hit_pos = viewPos(vec2(q) + 0.5, g.w);
            if (dot(hit_pos - pos, plane) < 0.05 + 0.01 * pos.z ||
                distance(vec2(q), s0) < 3.0) {
                // Hit the surface the ray left from: keep marching past it.
                last_u = u;
                last_z = ray_z;
                continue;
            }
            const vec2 uv = (vec2(q) + 0.5) / size;
            const vec2 edge = min(uv, 1.0 - uv);
            const float fade = smoothstep(0.0, 0.06, min(edge.x, edge.y));
            const vec3 c = texelFetch(color_tex, q, 0).rgb;
            hit_dist = distance(hit_pos, pos);
            return vec4(min(c, vec3(RAY_CLAMP)), fade);
        }
        last_u = u;
        last_z = ray_z;
    }
    return vec4(0.0);
}

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(hp, raySize()))) {
        return;
    }
    const ivec2 pixel = rayPixel(hp);
    const vec4 geo = texelFetch(geo_tex, pixel, 0);
    if (geo.w <= 0.0) {
        imageStore(ray_img, hp, vec4(0.0));
        imageStore(dist_img, hp, vec4(0.0));
        return;
    }
    const float roughness =
        wetRoughness(materialRoughness(texelFetch(material_tex, pixel, 0).r), geo.xyz);
    if (roughness > RAY_MAX_ROUGHNESS) {
        imageStore(ray_img, hp, vec4(0.0));
        imageStore(dist_img, hp, vec4(0.0));
        return;
    }
    const vec3 n = geo.xyz;
    const vec3 pos = viewPos(vec2(pixel) + 0.5, geo.w);
    const vec3 v = -normalize(pos);
    const vec3 plane = geometricNormal(pixel, pos, n);
    // Per-pixel random offset advanced along the R2 low-discrepancy sequence each frame, so the
    // samples a pixel accumulates over time cover the lobe evenly instead of clumping.
    // Near-mirror surfaces (wet ground) trace the exact reflection with a fixed per-pixel step
    // offset: their lobe is too narrow for sampling noise to matter, and a ray that is identical
    // every frame needs no temporal accumulation to be stable in motion.
    const bool mirror = roughness < MIRROR_ROUGHNESS;
    const uint seed = hash(uint(hp.x) * 73856093u ^ uint(hp.y) * 19349663u);
    const float k = mirror ? 0.0 : float(frame & 4095u);
    vec2 u = fract(vec2(rand(seed), rand(seed ^ 0x9e3779b9u)) +
                   k * vec2(0.75487766624669276, 0.56984029099805327));
    u.x *= GGX_TAIL_TRIM;
    const float noise = fract(rand(seed ^ 0x85ebca6bu) + k * 0.61803398875);
    const float alpha = max(roughness * roughness, 0.002);
    vec3 dir = mirror ? reflect(-v, n) : sampleGgxReflection(v, n, alpha, u);
    const float below = dot(dir, plane);
    if (below < 0.02) {
        dir = normalize(dir + plane * (0.02 - below));
    }
    const int steps = roughness < 0.35 ? RAY_STEPS_SMOOTH : RAY_STEPS;
    float hit_dist;
    imageStore(ray_img, hp, traceReflection(pos, plane, dir, noise, steps, hit_dist));
    imageStore(dist_img, hp, vec4(hit_dist));
}

#elif defined(RESOLVE)

layout(binding = 0) uniform texture2D geo_tex;
layout(binding = 1) uniform texture2D material_tex;
layout(binding = 2) uniform texture2D ray_tex;
layout(binding = 3) uniform texture2D prev_reflection_tex;
layout(binding = 4) uniform texture2D prev_diffuse_tex;
layout(binding = 5, rgba16f) uniform writeonly image2D reflection_img;
layout(binding = 6) uniform texture2D dist_tex;

const int FILTER_RADIUS = 2;
const float REFLECTION_BLEND = 0.07;
const float MIRROR_BLEND = 0.3;
const float HIT_BLEND = 0.1;
const float HISTORY_CLAMP = 1.75;
const float REFLECTION_DEPTH_TOLERANCE = 0.05;
const float VIRTUAL_DEPTH_TOLERANCE = 0.15;
const float VIRTUAL_MAX_ROUGHNESS = 0.45;

// Previous resolved reflection at full-resolution previous-frame pixel `pp`, validated against
// the previous view z kept in the probe diffuse history. At half resolution, each tap checks the
// pixel its texel represented last frame rather than mixing the block's four surfaces together.
bool fetchHistory(vec2 pp, float expected_z, float tolerance, out vec4 hist) {
    hist = vec4(0.0);
    const ivec2 full = ivec2(floor(pp));
    if (any(lessThan(full, ivec2(0))) || any(greaterThanEqual(full, ivec2(size)))) {
        return false;
    }
    const vec2 hf = fullResRays() ? pp - 0.5 : pp * 0.5 - 0.5;
    const ivec2 b = ivec2(floor(hf));
    const vec2 f = hf - vec2(b);
    const ivec2 hi = raySize() - 1;
    float wsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        const ivec2 o = ivec2(i & 1, i >> 1);
        const ivec2 q = clamp(b + o, ivec2(0), hi);
        const ivec2 previous_pixel = rayPixelAt(q, frame - 1u);
        const float prev_z = texelFetch(prev_diffuse_tex, previous_pixel, 0).a;
        if (prev_z <= 0.0 || abs(prev_z - expected_z) > tolerance * expected_z) {
            continue;
        }
        const float w = (o.x == 0 ? 1.0 - f.x : f.x) * (o.y == 0 ? 1.0 - f.y : f.y);
        hist += texelFetch(prev_reflection_tex, q, 0) * w;
        wsum += w;
    }
    if (wsum <= 1e-5) {
        hist = vec4(0.0);
        return false;
    }
    hist /= wsum;
    return true;
}

// Smooth reflections move with the reflected object, not the reflecting surface: reproject the
// virtual image point (behind the mirror, hit distance along the view ray) when it lands on the
// same surface, otherwise fall back to the surface motion.
bool reflectionHistory(vec3 pos, float roughness, float hit_dist, out vec4 hist) {
    const vec3 surface = toPrevious(pos);
    if (surface.z < 1e-3) {
        hist = vec4(0.0);
        return false;
    }
    if (hit_dist > 0.0 && roughness < VIRTUAL_MAX_ROUGHNESS) {
        const vec3 virt = toPrevious(pos + normalize(pos) * hit_dist);
        if (virt.z > 1e-3 &&
            fetchHistory(prevPixel(virt), surface.z, VIRTUAL_DEPTH_TOLERANCE, hist)) {
            return true;
        }
    }
    return fetchHistory(prevPixel(surface), surface.z, REFLECTION_DEPTH_TOLERANCE, hist);
}

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 rsize = raySize();
    if (any(greaterThanEqual(hp, rsize))) {
        return;
    }
    const ivec2 pixel = rayPixel(hp);
    const vec4 geo = texelFetch(geo_tex, pixel, 0);
    const float roughness =
        geo.w > 0.0
            ? wetRoughness(materialRoughness(texelFetch(material_tex, pixel, 0).r), geo.xyz)
            : 1.0;
    if (roughness > RAY_MAX_ROUGHNESS) {
        imageStore(reflection_img, hp, vec4(0.0));
        return;
    }
    const vec3 n = geo.xyz;
    const vec3 pos = viewPos(vec2(pixel) + 0.5, geo.w);

    // Smoother surfaces share rays with fewer neighbours, keeping their reflections sharper.
    const float sigma = mix(0.8, 2.0, roughness / RAY_MAX_ROUGHNESS) *
                        (fullResRays() ? 1.5 : 1.0);
    vec3 sum = vec3(0.0), m2 = vec3(0.0);
    float color_w = 0.0, hit_sum = 0.0, wsum = 0.0, moments = 0.0, dist_sum = 0.0;
    for (int y = -FILTER_RADIUS; y <= FILTER_RADIUS; ++y) {
        for (int x = -FILTER_RADIUS; x <= FILTER_RADIUS; ++x) {
            const ivec2 q = hp + ivec2(x, y);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, rsize))) {
                continue;
            }
            const ivec2 qp = rayPixel(q);
            const vec4 g = texelFetch(geo_tex, qp, 0);
            if (g.w <= 0.0) {
                continue;
            }
            const vec3 qpos = viewPos(vec2(qp) + 0.5, g.w);
            const float w = exp(-float(x * x + y * y) / (2.0 * sigma * sigma)) *
                            pow(max(dot(n, g.xyz), 0.0), 8.0) *
                            exp(-abs(dot(n, qpos - pos)) / (0.03 + 0.01 * geo.w));
            if (w < 1e-4) {
                continue;
            }
            const vec4 ray = texelFetch(ray_tex, q, 0);
            const vec3 c = compressColor(ray.rgb) * ray.a;
            wsum += w;
            hit_sum += ray.a * w;
            sum += c * w;
            m2 += c * c * w;
            moments += w;
            if (ray.a > 0.0) {
                const float cw = w * ray.a;
                color_w += cw;
                dist_sum += texelFetch(dist_tex, q, 0).r * cw;
            }
        }
    }
    // Radiance is premultiplied by hit coverage. Misses belong in both the average and its
    // variance; excluding them lets one bright ray define the clamp instead of being rejected.
    const vec3 current = wsum > 0.0 ? sum / wsum : vec3(0.0);
    const float hit = wsum > 0.0 ? hit_sum / wsum : 0.0;
    const float hit_dist = color_w > 0.0 ? dist_sum / color_w : 0.0;

    vec3 result = current;
    float result_hit = hit;
    vec4 hist;
    if ((history & 5u) == 5u && reflectionHistory(pos, roughness, hit_dist, hist)) {
        vec3 hist_c = compressColor(hist.rgb);
        if (moments > 0.0) {
            const vec3 mean = sum / moments;
            const vec3 sd = sqrt(max(m2 / moments - mean * mean, vec3(0.0)));
            hist_c = clamp(hist_c, mean - HISTORY_CLAMP * sd - 0.01,
                           mean + HISTORY_CLAMP * sd + 0.01);
        }
        // Mirror rays have a deterministic direction for a given surface, so follow motion faster.
        const float blend =
            mix(MIRROR_BLEND, REFLECTION_BLEND, smoothstep(0.08, 0.2, roughness));
        result = mix(hist_c, current, blend);
        result_hit = mix(hist.a, hit, HIT_BLEND);
    }
    imageStore(reflection_img, hp, vec4(expandColor(result), result_hit));
}

#elif defined(COMPOSITE)

layout(binding = 0) uniform texture2D geo_tex;
layout(binding = 1) uniform texture2D probe_tex;
layout(binding = 2) uniform texture2D light_tex;
layout(binding = 3) uniform texture2D sh_r;
layout(binding = 4) uniform texture2D sh_g;
layout(binding = 5) uniform texture2D sh_b;
layout(binding = 6, rgba16f) uniform image2D color_img;
layout(binding = 7) uniform texture2D albedo_tex;
layout(binding = 8) uniform texture2D ao_tex;
layout(binding = 9) uniform texture2D material_tex;
layout(binding = 10) uniform texture2D specular_tex;
layout(binding = 11) uniform texture2D prev_diffuse_tex;
layout(binding = 12) uniform texture2D prev_specular_tex;
layout(binding = 13, rgba16f) uniform writeonly image2D diffuse_img;
layout(binding = 14, rgba16f) uniform writeonly image2D specular_img;
layout(binding = 15) uniform texture2D reflection_tex;

const float MAX_RESOLVE_HISTORY = 16.0;
const float RESOLVE_DEPTH_TOLERANCE = 0.05;

// Per-pixel accumulation of the resolved probe lighting. Probes are re-placed every frame as the
// camera moves, which alone gives a different interpolation each frame; reprojecting the
// resolved result keeps it stable. diffuse.a = view z (validates the reprojection), specular.a =
// accumulated frame count.
bool resolveHistory(vec3 pos, out vec3 diffuse, out vec3 spec, out float count) {
    diffuse = vec3(0.0);
    spec = vec3(0.0);
    count = 0.0;
    const vec3 p = toPrevious(pos);
    if (p.z < 1e-3) {
        return false;
    }
    const vec2 hf = prevPixel(p) - 0.5;
    const ivec2 b = ivec2(floor(hf));
    const vec2 f = hf - vec2(b);
    const ivec2 hi = ivec2(size) - 1;
    float wsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        const ivec2 o = ivec2(i & 1, i >> 1);
        const ivec2 t = b + o;
        if (any(lessThan(t, ivec2(0))) || any(greaterThan(t, hi))) {
            continue;
        }
        const vec4 d = texelFetch(prev_diffuse_tex, t, 0);
        if (d.a <= 0.0 || abs(d.a - p.z) > RESOLVE_DEPTH_TOLERANCE * p.z) {
            continue;
        }
        const vec4 s = texelFetch(prev_specular_tex, t, 0);
        const float w = (o.x == 0 ? 1.0 - f.x : f.x) * (o.y == 0 ? 1.0 - f.y : f.y);
        diffuse += d.rgb * w;
        spec += s.rgb * w;
        count += s.a * w;
        wsum += w;
    }
    if (wsum < 0.25) {
        return false;
    }
    diffuse /= wsum;
    spec /= wsum;
    count /= wsum;
    return true;
}

float sampleAo(ivec2 pixel) {
    const ivec2 ao_size = textureSize(ao_tex, 0);
    const vec2 p = (vec2(pixel) + 0.5) / size * vec2(ao_size) - 0.5;
    const ivec2 p0 = ivec2(floor(p));
    const vec2 f = p - vec2(p0);
    const ivec2 hi = ao_size - 1;
    const float a = texelFetch(ao_tex, clamp(p0, ivec2(0), hi), 0).r;
    const float b = texelFetch(ao_tex, clamp(p0 + ivec2(1, 0), ivec2(0), hi), 0).r;
    const float c = texelFetch(ao_tex, clamp(p0 + ivec2(0, 1), ivec2(0), hi), 0).r;
    const float d = texelFetch(ao_tex, clamp(p0 + ivec2(1, 1), ivec2(0), hi), 0).r;
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Karis' analytic fit of the split-sum environment BRDF, plus the energy single-scattering GGX
// loses at high roughness (Fdez-Aguera 2019), which otherwise makes rough metals too dark.
vec3 envBrdf(vec3 f0, float roughness, float n_dot_v) {
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
    const vec4 r = roughness * c0 + c1;
    const float a004 = min(r.x * r.x, exp2(-9.28 * n_dot_v)) * r.x + r.y;
    const vec2 ab = vec2(-1.04, 1.04) * a004 + r.zw;
    const vec3 single = f0 * ab.x + ab.y;
    // The fit undershoots single-scattering energy when very rough; the floor caps the boost at 2x.
    const float energy = clamp(ab.x + ab.y, 0.5, 1.0);
    return max(single, vec3(0.0)) * (1.0 + f0 * (1.0 / energy - 1.0));
}

// The GGX reflection lobe leans towards the normal as it widens (Lagarde & de Rousiers 2014).
vec3 ggxDominantDirection(vec3 n, vec3 r, float roughness) {
    const float a = roughness * roughness;
    return normalize(mix(n, r, (1.0 - a) * (sqrt(1.0 - a) + a)));
}

// Band-1 zonal factor of the GGX reflection lobe, fitted as a von Mises-Fisher lobe of
// sharpness 1 / (2 alpha^2): blurs the probe radiance by the material's lobe width.
float ggxBand1(float roughness) {
    const float a = max(roughness * roughness, 1e-3);
    const float k = 1.0 / (2.0 * a * a);
    if (k > 20.0) {
        return 1.0 - 1.0 / k;
    }
    const float e = exp(-2.0 * k);
    return (1.0 + e) / (1.0 - e) - 1.0 / k;
}

// Lagarde & de Rousiers 2014: the share of the specular lobe ambient occlusion blocks.
float specularOcclusion(float n_dot_v, float ao, float roughness) {
    const float a = roughness * roughness;
    return clamp(pow(n_dot_v + ao, exp2(-16.0 * a - 1.0)) - 1.0 + ao, 0.0, 1.0);
}

// Joint bilateral upsample of the half-resolution glossy reflections. a = hit confidence.
vec4 sampleReflection(ivec2 pixel, float z, vec3 n) {
    if (fullResRays()) {
        return texelFetch(reflection_tex, pixel, 0);
    }
    const ivec2 hsize = raySize();
    const vec2 hf = (vec2(pixel) + 0.5) * 0.5 - 0.5;
    const ivec2 b = ivec2(floor(hf));
    const vec2 f = hf - vec2(b);
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        const ivec2 o = ivec2(i & 1, i >> 1);
        const ivec2 q = clamp(b + o, ivec2(0), hsize - 1);
        const vec4 g = texelFetch(geo_tex, rayPixel(q), 0);
        if (g.w <= 0.0) {
            continue;
        }
        const float w = (o.x == 0 ? 1.0 - f.x : f.x) * (o.y == 0 ? 1.0 - f.y : f.y) *
                        exp(-abs(g.w - z) / (0.02 * z)) * pow(max(dot(n, g.xyz), 0.0), 8.0) +
                        1e-5;
        sum += texelFetch(reflection_tex, q, 0) * w;
        wsum += w;
    }
    return wsum > 0.0 ? sum / wsum : vec4(0.0);
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    const vec4 geo = texelFetch(geo_tex, pixel, 0);
    if (geo.w <= 0.0) {
        imageStore(diffuse_img, pixel, vec4(0.0));
        imageStore(specular_img, pixel, vec4(0.0));
        return;
    }
    const vec3 n = geo.xyz;
    const float z = geo.w;
    const vec3 pos = viewPos(vec2(pixel) + 0.5, z);
    const vec3 v = -normalize(pos);

    float roughness = 1.0, probe_roughness = 1.0;
    vec3 f0 = vec3(0.0);
    bool specular = material_on > 0.5 && specular_scale > 0.0;
    bool ray_specular = false;
    if (specular) {
        probe_roughness = materialRoughness(texelFetch(material_tex, pixel, 0).r);
        roughness = (history & 2u) != 0u ? wetRoughness(probe_roughness, n) : probe_roughness;
        const vec3 s = texelFetch(specular_tex, pixel, 0).rgb;
        f0 = s * s;
        ray_specular = (history & 2u) != 0u && roughness <= RAY_MAX_ROUGHNESS;
        // Probe specular only on rough surfaces: the probes are too coarse for sharp reflections,
        // which are left to the glossy rays (if on), screen-space reflections and cubemaps. It
        // keeps the game's roughness, as the fallback where wet-ground rays miss.
        specular = probe_roughness > 0.4;
    }
    vec3 r = vec3(0.0);
    float band1 = 1.0;
    if (specular) {
        r = ggxDominantDirection(n, reflect(-v, n), probe_roughness);
        band1 = ggxBand1(probe_roughness);
    }

    const ivec2 tiles = tileCount();
    const ivec2 centre = pixel / TILE;
    vec3 irradiance = vec3(0.0), radiance = vec3(0.0);
    float weight = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            const ivec2 pt = centre + ivec2(x, y);
            if (any(lessThan(pt, ivec2(0))) || any(greaterThanEqual(pt, tiles))) {
                continue;
            }
            const vec4 probe = texelFetch(probe_tex, pt, 0);
            if (probe.y <= 0.0) {
                continue;
            }
            const vec3 pp = probePixel(pt, probe);
            const vec3 ppos = viewPos(pp.xy, pp.z);
            const vec3 pn = octDecode(probe.zw);
            const float dist = length(vec2(pixel) + 0.5 - pp.xy) / float(TILE);
            const float w = exp(-2.0 * dist * dist) *
                            exp(-abs(dot(pn, pos - ppos)) / (0.02 + 0.02 * z)) *
                            pow(max(dot(n, pn), 0.0), 4.0);
            if (w < 1e-5) {
                continue;
            }
            const vec4 cr = texelFetch(sh_r, pt, 0), cg = texelFetch(sh_g, pt, 0),
                       cb = texelFetch(sh_b, pt, 0);
            irradiance += shIrradiance(cr, cg, cb, n) * w;
            if (specular) {
                radiance += shRadiance(cr, cg, cb, r, band1) * w;
            }
            weight += w;
        }
    }
    if (weight > 1e-4) {
        irradiance /= weight;
        radiance /= weight;
    }

    vec3 hist_diffuse, hist_spec;
    float count;
    if ((history & 1u) != 0u && resolveHistory(pos, hist_diffuse, hist_spec, count)) {
        count = min(count + 1.0, MAX_RESOLVE_HISTORY);
        // Pixels with no usable probe this frame keep their history instead of going dark.
        const float a = weight > 1e-4 ? 1.0 / count : 0.0;
        irradiance = mix(hist_diffuse, irradiance, a);
        radiance = mix(hist_spec, radiance, a);
    } else if (weight > 1e-4) {
        count = 1.0;
    } else {
        imageStore(diffuse_img, pixel, vec4(0.0, 0.0, 0.0, z));
        imageStore(specular_img, pixel, vec4(0.0));
        return;
    }
    imageStore(diffuse_img, pixel, vec4(irradiance, z));
    imageStore(specular_img, pixel, vec4(radiance, count));

    vec4 color = imageLoad(color_img, pixel);
    vec3 albedo;
    if (albedo_on > 0.5) {
        albedo = texelFetch(albedo_tex, pixel, 0).rgb;
    } else {
        const float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
        albedo = ALBEDO * mix(vec3(1.0), clamp(color.rgb / max(luma, 1e-3), 0.0, 2.5), 0.6);
    }
    const float ao = ao_amount > 0.0
                         ? max(1.0 - ao_amount * (1.0 - clamp(sampleAo(pixel), 0.0, 1.0)), 0.0)
                         : 1.0;
    // Specular occlusion replaces plain AO on the specular: AO is meant for diffuse light, and
    // traced reflection hits are already occluded by what they hit.
    const float n_dot_v = max(dot(n, v), 1e-3);
    vec3 add = albedo * irradiance * (diffuse_scale / PI) * ao;
    if (specular || ray_specular) {
        vec3 spec = specular ? radiance * smoothstep(0.4, 0.6, probe_roughness) : vec3(0.0);
        spec *= specularOcclusion(n_dot_v, ao, probe_roughness);
        const vec3 brdf = envBrdf(f0, roughness, n_dot_v);
        if (ray_specular) {
            const float t = 1.0 - smoothstep(0.55, RAY_MAX_ROUGHNESS, roughness);
            const float strength =
                float((history >> 8u) & 255u) * (REFLECTION_STRENGTH_SCALE / 255.0);
            vec3 reflected = vec3(0.0);
            if (strength > 0.0) {
                reflected = sampleReflection(pixel, z, n).rgb * strength;
            }
            spec = mix(spec, reflected, t);
        }
        add += spec * brdf * specular_scale;
    }
    color.rgb += add;
    imageStore(color_img, pixel, color);
}

#endif
